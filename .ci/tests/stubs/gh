#!/usr/bin/env bash
# Stand-in for gh in the tooling tests: nothing reaches GitHub. Every call is
# appended to $STUB_LOG.
#   STUB_TIP=<sha>           `gh api .../git/ref/heads/<branch>` answers this commit
#   STUB_LOOKUP_FAIL=1       every `gh api` call fails with a server error
#   STUB_TAGS=<tag>[,<tag>]  these tags exist; any other tag lookup is HTTP 404
#   STUB_RELEASE_FAIL=1      `gh release create` fails
#   STUB_DISPATCH_FAIL=1     `gh api --method POST .../dispatches` fails
#   STUB_DISPATCH_HANG=1     the dispatch call sleeps for a minute
#
# A dispatch is logged as `DISPATCH <path> <request body>`; the token the call
# ran with is written to $STUB_LOG.token, never to $STUB_LOG.
#
# The issue tracker is a JSON file in $STUB_GH_DIR (issues.json, an array of
# {number, title, body, state, state_reason, labels: [{name}], comments}).
# Every write is also appended to $STUB_GH_DIR/writes.log, one line each.
#   STUB_GH_FAIL=<kind>      a write of this kind (label, create, comment, patch) fails
# shellcheck disable=SC2016 # the jq filters name jq variables, not shell ones
set -euo pipefail

printf 'gh %s\n' "$*" >>"$STUB_LOG"

issues_file() {
  : "${STUB_GH_DIR:?}"
  [ -f "$STUB_GH_DIR/issues.json" ] || echo '[]' >"$STUB_GH_DIR/issues.json"
  printf '%s\n' "$STUB_GH_DIR/issues.json"
}

# write <kind> <log line> records a write, or fails it when asked to.
write() {
  if [ "${STUB_GH_FAIL:-}" = "$1" ]; then
    echo "gh: Server Error (HTTP 500)" >&2
    exit 1
  fi
  printf '%s\n' "$2" >>"$STUB_GH_DIR/writes.log"
}

# update <jq filter> [jq args...] rewrites issues.json.
update() {
  local file filter="$1"
  shift
  file="$(issues_file)"
  jq "$@" "$filter" "$file" >"$file.new"
  mv "$file.new" "$file"
}

case "${1:-}" in
  api)
    shift
    method=GET path="" input=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --method)
          method="$2"
          shift 2
          ;;
        --input)
          input="$2"
          shift 2
          ;;
        --jq)
          shift 2
          ;;
        *)
          path="$1"
          shift
          ;;
      esac
    done
    request="{}"
    if [ "$input" = - ]; then
      request="$(cat)"
    fi
    if [ "${STUB_LOOKUP_FAIL:-}" = 1 ]; then
      echo "gh: Server Error (HTTP 500)" >&2
      exit 1
    fi
    case "$method $path" in
      "POST repos/"*/dispatches)
        [ "${STUB_DISPATCH_HANG:-}" != 1 ] || exec sleep 60
        printf '%s' "${GH_TOKEN-unset}" >"$STUB_LOG.token"
        printf 'DISPATCH %s %s\n' "$path" "$(jq -c . <<<"$request")" >>"$STUB_LOG"
        if [ "${STUB_DISPATCH_FAIL:-}" = 1 ]; then
          echo "gh: Resource not accessible by personal access token (HTTP 403)" >&2
          exit 1
        fi
        ;;
      "GET "*/git/ref/heads/*)
        printf '%s\n' "${STUB_TIP:?}"
        ;;
      "GET "*/git/ref/tags/*)
        tag="${path##*/}"
        case ",${STUB_TAGS:-}," in
          *",$tag,"*) echo '{"ref":"refs/tags/'"$tag"'"}' ;;
          *)
            echo "gh: Not Found (HTTP 404)" >&2
            exit 1
            ;;
        esac
        ;;
      "GET repos/"*/issues\?*)
        query="${path#*\?}"
        state="" labels="" per_page=30 page=1
        IFS='&' read -ra pairs <<<"$query"
        for pair in "${pairs[@]}"; do
          case "$pair" in
            state=*) state="${pair#*=}" ;;
            labels=*) labels="${pair#*=}" ;;
            per_page=*) per_page="${pair#*=}" ;;
            page=*) page="${pair#*=}" ;;
          esac
        done
        jq --arg state "$state" --arg labels "$labels" --argjson per "$per_page" --argjson page "$page" \
          '[.[] | select(.state == $state) | select($labels == "" or any(.labels[]; .name == $labels))]
           | .[($page - 1) * $per : $page * $per]' "$(issues_file)"
        ;;
      "GET repos/"*/labels/*)
        [ -f "$STUB_GH_DIR/label" ] || {
          echo "gh: Not Found (HTTP 404)" >&2
          exit 1
        }
        echo '{"name":"image-update"}'
        ;;
      "POST repos/"*/labels)
        write label "LABEL $(jq -r .name <<<"$request")"
        : >"$STUB_GH_DIR/label"
        echo '{}'
        ;;
      "POST repos/"*/issues)
        number="$(jq '(map(.number) | max // 0) + 1' "$(issues_file)")"
        write create "CREATE #$number $(jq -r .title <<<"$request")"
        update '. + [{number: $n, title: $r.title, body: $r.body, state: "open", state_reason: null,
                      labels: [$r.labels[] | {name: .}], comments: []}]' --argjson n "$number" --argjson r "$request"
        echo "{\"number\": $number}"
        ;;
      "POST repos/"*/issues/*/comments)
        number="${path%/comments}"
        number="${number##*/}"
        write comment "COMMENT #$number $(jq -r .body <<<"$request")"
        update 'map(if .number == $n then .comments += [$r.body] else . end)' --argjson n "$number" --argjson r "$request"
        echo '{}'
        ;;
      "PATCH repos/"*/issues/*)
        number="${path##*/}"
        write patch "PATCH #$number $(jq -c . <<<"$request")"
        update 'map(if .number == $n then . + $r else . end)' --argjson n "$number" --argjson r "$request"
        echo '{}'
        ;;
      *)
        echo "gh stub: unexpected api call: $method $path" >&2
        exit 2
        ;;
    esac
    ;;
  release)
    [ "${2:-}" = create ] || {
      echo "gh stub: unexpected release call: $*" >&2
      exit 2
    }
    [ "${STUB_RELEASE_FAIL:-}" != 1 ] || {
      echo "gh: release failed" >&2
      exit 1
    }
    ;;
  *)
    echo "gh stub: unexpected call: $*" >&2
    exit 2
    ;;
esac
